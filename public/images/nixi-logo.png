body{
background-color: #fff;
font-family: "poppins", sans-serif !important;
font-size: 14px !important;
font-weight: 400;
line-height: 24px !important;
/* overflow: visible; */
/* overflow-x: hidden; */
/* overflow-y: scroll; */
position: relative;
color: #212529;
/* 	text-transform:capitalize; */
}
/** Header Menu **/
.header-main{
	top:0;
	left: 0;
    position: fixed;
    right: 0;
    z-index: 1002;
    background: linear-gradient(
180deg, black, transparent);
}
.has-nav{
	    height: 82px;
    display: flex;
    align-items: center
}
.nav-ul li>a {
	text-transform : none;
	font-weight: 500;
/* 	color: #fff; */
	letter-spacing:0.1em;
	font-size: 14px;
}
.primary-menu-ul.nav-ul li>a {
    color: #fff;
}

@media screen and (max-width: 767px) {
  .primary-menu-ul.nav-ul li>a {
    color: #111;
}
}
.header-menu-sidebar-bg ul li a {
color:#4c4c4c;	
	padding: 5px 0 !important;
	    display: block;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.2em;
}
.header-menu-sidebar-bg ul li a span{
	display:block;
	font-size: 16px;
}

.header-menu-sidebar .nav-ul{
	margin-top: 280px;
}
.nav-ul li:nth-child(7):hover  {
	background-color: orange !important;
}
.nav-ul li:nth-child(7) a {
padding-left:6px;
padding-right:6px;
}
.nav-ul li:nth-child(7) a:hover {
	color:#2e2e90 !important;
}

.nav-ul li:not(nth-child(7)):hover a{
	color:#2e2e90;
}


.nav-ul li>a:hover {
	color: #f07f36;
	text-decoration: none;
}

.nav-ul li.current-menu-item>a{
		color: #f07f36;
}
.nav-ul {
        margin-right: 30px;
     margin-bottom: 0;   
    }
.navbar-toggle{
	background-color: #fff;
	border: 0;
}

.nav-ul .sub-menu li>a{
	color: black;
	text-align: center;
  display: block;
}

.nav-ul .caret {
	display:none;
}
.navbar-toggle{
	position:absolute;
	right:0;
	padding:15px 20px;
	top:-14px;
}
.style-border-bottom a:hover::after, .style-border-top a:hover::after, .style-full-height a:hover::after{
	display:none;
}


@media(min-width:992px){
	nav .hfg-slot.left{
		display:none
	}
	nav .hfg-slot.right{
	justify-content:flex-start;
}
	nav .hfg-slot.right{
		padding-left: 110px;
	}
}

/* G Translate  */
.switcher{
	width: 92px !important;
	top:35px;
	position: fixed;
	left:40px !important;
	
}
.switcher .selected a:after{
	top:0;
}
.switcher .selected a{
		width:80px !important;
}
.switcher a{
	font-size:10px !important;
}

.switcher img{
	display:none !important;
}

.switcher .selected{
	width:92px;
}


/* G Translate End */

/* accessibility-features page*/
.archive-container{
	height: 500px;
}

/* Contact Us Page */

.contact-details .info-card .info-body a{
	    color: #212529;
}
.contact-details .info-card .info-body a:hover{
	    color: #2e2e90;
}

/* Contact Us End */

/*  Feedback form */
.wpcf7-form{
	display: flex;
    /* flex: 1; */
    flex-wrap: wrap;
}
.wpcf7-form p{
	flex: 1;
	 flex-basis: 35%;
    margin-right: 25px;
}

.wpcf7-form p label{
	width:100%;
	color: #4c4c4c;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

.wpcf7-form p label span{
	    margin-top: 12px;
    display: block;
	  text-transform: none;
}

.wpcf7-form p label span input,.wpcf7-form p label span textarea,.wpcf7-form p label span select {
	background-color: #ffffff;
    border: 1px solid #ededed;
    box-shadow: 0 0px 10px 0px rgb(0 0 0 / 18%);
    color: #7f7f7f;
    font-size: 13px;
    border-radius: 10px;
    height: 45px;
    letter-spacing: 0.1em;
    padding-bottom: 9px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 9px;
    width: 100%;
}
.wpcf7-form p label span select,.wpcf7-form p label span input,.wpcf7-form p label span textarea{
	text-transform:none;
}

.wpcf7-form p label span textarea{
	height : 200px !important;
}

.wpcf7-form p:nth-last-child(2){
	flex-basis:100%
}

.wpcf7-form p .wpcf7-submit{
	border-radius: 5px;
    box-sizing: border-box;
    height: 45px;
    padding: 2px;
    width: 120px;
    font-size: 14px;
	background: #323193;
    box-shadow: 0 10px 15px 0 rgb(175 0 87 / 20%);
	color:#fff;
	cursor:pointer;
}
.wpcf7-form p .wpcf7-submit:hover{
	background: #f07f36;
	color:#fff;
}

/* Feedback form end */


/** footer **/
.footer--row .builder-item{
	margin: 0;
}
.page_footer .widget_icons_list p {
	text-transform: initial;
}


#back2Top {
   background-color: #f07f36;
    border-radius: 50%;
    bottom: 10px;
    color: white;
    display: none;
    font-size: 12px;
    height: 60px;
    opacity: 0.7;
    overflow: hidden;
    position: fixed;
    right: 10px;
    text-decoration: none;
    width: 60px;
    z-index: 1000;
	  display: flex;
    align-items: center;
    justify-content: center;
	transition: all 0.2s ease-in-out 0s;
}
#back2Top:hover {
 bottom: 3px;
    opacity: 1;
}

/** footer end **/



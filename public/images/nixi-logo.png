<style type="text/css">
/* Notice page Sup */

sup.Notice-sup {
    color: red;
    font-weight: bold;
}

.nav-ul>li {
    margin: 0 calc(var(--spacing)/ 3);
}

.header-menu-sidebar .nav-ul {
    margin-top: 300px!important;
}


/* end  Notice page Sup */

/*-----for Internal Notice page----*/

.middle-center h4 {
    font-size: 17px;
    /* text-transform: uppercase; */
    color: #02559bcf;
    margin: 0.5em 0 0.5em;
    padding: 3px;
/*     padding-left: 1em; */
    font-family: "Roboto",Corbel,Avenir,"Lucida Grande","Lucida Sans",sans-serif;
}

.middle-center p {
    font-size: 14px;
    color: #635a5a;
    font-family: "Roboto",Corbel,Avenir,"Lucida Grande","Lucida Sans",sans-serif;
    margin: 1em 0;
    line-height:30px;
    word-spacing: 0.1em;
/*     padding-left: 1em; */
    padding-right: 1em;
}

table.fold-table td {
    padding: 1.1em;
}

/*-----for Internal Notice page end ----*/


/*--------Notice page byaccordion-----*/

 table th {
	 text-align: left;
	 border-bottom: 1px solid #ccc;
}
 table th, table td {
	 padding: 0.4em;
}
 table.fold-table > tbody > tr.view td, table.fold-table > tbody > tr.view th {
	 cursor: pointer;
}
 table.fold-table > tbody > tr.view td:last-child, table.fold-table > tbody > tr.view th:last-child {
	 position: relative;
	 padding-left: 20px;
}
 table.fold-table > tbody > tr.view td:last-child:before, table.fold-table > tbody > tr.view th:last-child:before {
	 position: absolute;
	 top: 50%;
	 right: 5px;
	 width: 9px;
	 height: 16px;
	 margin-top: -8px;
	 font: 16px fontawesome;
	 color: #999;
	 content: "\f0d7";
	 transition: all 0.3s ease;
}
 table.fold-table > tbody > tr.view:nth-child(4n-1) {
	 background: #eee;
}
 table.fold-table > tbody > tr.view:hover {
	 background: #ddd;
}
 table.fold-table > tbody > tr.view.open {
	 background: tomato;
	 color: white;
}
 table.fold-table > tbody > tr.view.open td:first-child:before, table.fold-table > tbody > tr.view.open th:first-child:before {
	 transform: rotate(-180deg);
	 color: #333;
}
 table.fold-table > tbody > tr.fold {
	 display: none;
}
 table.fold-table > tbody > tr.fold.open {
	 display: table-row;
}
 .fold-content {
	 padding: 0.5em;
}
 .fold-content h3 {
	 margin-top: 0;
}
 .fold-content > table {
	 border: 2px solid #ccc;
}
 .fold-content > table > tbody tr:nth-child(even) {
	 background: #eee;
}

/*----details-of-pio-appellate-authority-----*/

th.divTitle {
    text-align: center;
    background: #323394;
    color: #fff;
}
 /*----end details-of-pio-appellate-authority-----*/
/*-----site map page -----*/
.middle-center.site-map ul li {
    list-style: disc;
}
/*-----end site map page -----*/

/*---------Notice page accordion end ----*/


@media screen and (min-width: 480px) {
  .primary-menu-ul.nav-ul li>a {
    color: #111;
}
}

@media screen and (max-width: 767px) {
  .primary-menu-ul.nav-ul li>a {
    color: #111;
}
	#mvcwid {justify-content: center !important;}
	#footer-menu {margin-right: 0px;}
}


/*---------Counter Css ----*/

#mvcwid {
        display: flex;
    align-items: center;
    justify-content: flex-end;
	    padding: 2px;
}
.wps_visitor_title{font-size: 12px;
    font-weight: 500;
    margin-right: 10px;
    margin-bottom: 0px;
	font-family: "poppins", sans-serif !important;
	text-transform: uppercase;
    letter-spacing: 0.6px;
  }
#wpsvccount img{width:15px}

#wpsvcviews{font-size: 12px;}

 .builder-item--footer-one-widgets.wp-container-4.wp-block-columns.are-vertically-aligned-center,.builder-item--footer-one-widgets .wp-block-columns
{
    margin-bottom: 0px;
}


/* ----- Footer Menu Text color----- */

.footer-top .nav-ul li.current-menu-item>a {
    color: #111!important;
}

.photo_gallery img.swiper-slide-image.swiper-lazy.swiper-lazy-loaded{height:150px;width:100%;object-fit:cover;}
  





</style>

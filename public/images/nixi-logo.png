    width: 90%;
} 
.homebanner .banner-text img {
    width: 70%;
} 
}

@media (max-width: 416px) {

}

@media (max-width: 376px) {
.verticals .col-lg-4.col-md-4.col-sm-4.col-4 {
    flex: 100%;
    max-width: 100%;
}
.plan-desc .price-icon img {
    width: 40%;
}
.plan-desc .price-icon {
    margin: 10px auto;
}
}

@media (max-width: 360px) {

}

@media (max-width: 320px) {
.homebanner .banner-text img {
    width: 62%;
}
}

@media (min-width: 945px) {
	.nav-ul li:nth-child(9),	.nav-ul li:nth-child(10),	.nav-ul li:nth-child(11),	.nav-ul li:nth-child(12){
		display:block;
	}
}
@media (min-width: 1200px) and (max-width:1600px) {
	.switcher,
	.switcher .selected a{
    width: 85px !important;    
    left: 15px !important;
}
	
}

@media (min-width: 1200px) and (max-width:1600px) {
	.nav-ul{
		padding-left:0px;
		margin-right: 30px;
	}
	.nav-ul li>a{
		font-size:12px;
	}
	
}

@media (max-width: 944px) {
	.nav-ul li:nth-child(9),	.nav-ul li:nth-child(10),	.nav-ul li:nth-child(11),	.nav-ul li:nth-child(12){
		display:block !important;
	}
	.page_header_side.header_side_right{
		display:none !important;
	}
}
@media (max-width: 959px){
	.page_header_side.header_side_right .toggle_menu_side{
		display:none !important;
	}
	.switcher,
	.switcher .selected a{
    top: 6px !important;    

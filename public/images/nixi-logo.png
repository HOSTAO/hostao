	justify-content:flex-end;
}
}

@media (max-width: 641px) {
.plan-desc .price-icon img {
    width: 80%;
} 
footer .col {
    margin: 20px 0 10px;
}
.contact-details .col {
    flex: 100%;
    max-width: 100%;
}
.table {
    width: 700px !important;
}
}

@media (max-width: 480px) {
